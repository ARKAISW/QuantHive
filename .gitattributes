# Handle line endings automatically for files detected as text
* text=auto

# Declare files that will always have LF line endings on checkout/commit
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf

# Denote binary files
*.png -text
*.jpg -text
*.webp -text
